{
  "name": "ramflow-website",
  "private": true,
  "description": "RAMFLOW official website (static, data from GitHub Releases + signed RAMFLOW ADMIN catalog)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "fetch": "node scripts/fetch-releases.mjs",
    "build": "node scripts/fetch-releases.mjs && node scripts/build.mjs",
    "build:only": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
